// Shema `ulaznice` u Supabaseu na api.domovina.ai kao DBML (stanje 2026-11-25, nakon S6 lanca i odobravanja događaja).
//
// Izvor istine su migracije 20261125150000_ulaznice_shema (tablice, RLS, trigeri),
// 20261125150100_ulaznice_media_bucket, 20261125160000_ulaznice_rpc_narudzbe i
// 20261125170000_ulaznice_rpc_eventi (RPC-i) i 20261125180000_ulaznice_odobrenje (odobravanje događaja). Ovaj DBML je pogled na njih: promjena sheme
// ide u novu migraciju i ovdje u istom commitu.
//
// Prikaz: https://stepanic.github.io/open-diagram/?url=https://github.com/domovinatv/domovina-api/blob/main/docs/ulaznice-shema/ulaznice.dbml
// Plan i odluke: docs/ulaznice-shema/ (plan.md, decisions.md).

Project ulaznice {
  database_type: 'PostgreSQL'
  Note: '''
    # Shema `ulaznice` (domovina ulaznice)

    Ticketing odvojen iz `pinka_finance` (gdje je bio izmodeliran kao crowdfunding kampanja
    `campaigns type='tickets'`) u vlastitu shemu. Na produkciji od 2026-11-25 (S6).
    Stari ticketing u `pinka_finance` zamrznut je (trigger `ulaznice_zamrznuto`) do brisanja u S7.

    ## Kako čitati

    - **Ljubičasto**: događaj i prodaja (`events`, `ticket_tiers`, `event_access`).
    - **Zeleno**: narudžba, ulaznice i audit (`orders`, `tickets`, `order_events`).
    - **Narančasto**: organizator i odobravanje (allowlist, admini platforme, DAC7, Stripe Connect).
    - **Sivo**: zajednička jezgra izvan sheme (`public.accounts`, `auth.users`).
    - **DiagramView** (izbornik gore): kupnja, organizator, ulaz na događaj.

    ## Pravila

    1. Sve tablice imaju RLS; pisanje ide kroz `SECURITY DEFINER` RPC-e i edge funkcije
       `events-*`, ne izravno. PostgREST profil `ulaznice` (`PGRST_DB_SCHEMAS`).
    2. `id` eventa = stari `campaigns.id`, `id` narudžbe = stari `contributions.id` (odluka 2).
    3. QR: u bazi samo sha256 hash tokena; plaintext živi do prve dostave (`qr_token_once`).
    4. Slike: bucket `ulaznice-media/{uid}/…` (umjesto `pinka-covers`).
  '''
}

// =====================================================================================
// Jezgra (izvan sheme)
// =====================================================================================

Table public.accounts [headercolor: #6b7280, note: 'Zajednički računi (osobni i org); vlasnik eventa, kupac, organizator'] {
  id uuid [pk]
}

Table auth.users [headercolor: #6b7280, note: 'GoTrue korisnici; tko je skenirao ulaznicu, tko je upisao allowlist'] {
  id uuid [pk]
}

// =====================================================================================
// Događaj i prodaja
// =====================================================================================

Enum ulaznice.ticket_state {
  issued [note: 'izdana, vrijedi za ulaz']
  checked_in [note: 'skenirana na ulazu (redeem_ticket)']
  void [note: 'poništena (void_ticket, refund)']
}

Table ulaznice.events [headercolor: #7c3aed, note: 'Događaj: spojeni campaigns type=tickets + pinka_finance.events. id = stari campaigns.id. Pisanje: create_event, update_event, publish_event, delete_event_draft, submit_event_for_review, approve_event, reject_event'] {
  id uuid [pk, default: `gen_random_uuid()`, note: '= campaigns.id']
  account_id uuid [not null, ref: > public.accounts.id, note: 'org account vlasnik; on delete cascade']
  slug citext [not null, unique, note: 'nepromjenjiv (trigger guard_immutable_slug)']
  title text [not null, note: '1–160 znakova']
  description text
  currency text [not null, default: 'eur']
  state text [not null, default: 'draft', note: 'draft | active | closed']
  visibility text [not null, default: 'private', note: 'private | unlisted | public']
  event_type text [not null, default: 'ostalo']
  attendance_mode text [not null, default: 'physical', note: 'physical | online']
  venue_name text [not null]
  venue_address text
  venue_city text [not null]
  venue_lat "numeric(9,6)" [note: 'u paru s venue_lon']
  venue_lon "numeric(9,6)"
  starts_at timestamptz [note: 'null = najavljen bez termina']
  ends_at timestamptz [note: '> starts_at']
  timezone text [not null, default: 'Europe/Zagreb']
  description_hr text
  description_en text
  cover_image_url text [note: 'https://, ulaznice-media']
  cover_image_alt text
  gallery jsonb [not null, default: `'[]'::jsonb`, note: '[{url, alt}], ≤ 20 (events_gallery_valid)']
  organizer_name text [not null]
  organizer_email text
  organizer_web text
  deleted_at timestamptz [note: 'soft-delete skice']
  submitted_at timestamptz [note: 'skica poslana na odobrenje (submit_event_for_review); null nakon reject_event']
  reviewed_at timestamptz [note: 'admin platforme odobrio ili odbio']
  review_note text [note: 'razlog odbijanja, ≤ 1000']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    account_id [name: 'ix_events_account']
    (visibility, state, created_at) [name: 'ix_events_public_feed', note: 'where deleted_at is null; javni feed (events-feed)']
  }
}

Table ulaznice.ticket_tiers [headercolor: #7c3aed, note: 'Vrsta ulaznice (bivši campaign_tiers kind=ticket). Pisanje kroz create_event/update_event (ticket_tiers_write_guard)'] {
  id uuid [pk, default: `gen_random_uuid()`]
  event_id uuid [not null, ref: > ulaznice.events.id, note: 'on delete cascade']
  title text [not null]
  description text
  price_cents integer [not null, default: 0, note: '≥ 0; 0 = besplatna (rail free)']
  inventory_total integer [note: 'null = neograničeno']
  inventory_claimed integer [not null, default: 0]
  sort integer [not null, default: 0]
  imenska boolean [not null, default: false, note: 'traži ime vlasnika po komadu (orders.holders)']
  sale_start timestamptz [note: 'null = prodaja otvorena']
  sale_end timestamptz [note: 'null = bez roka']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (event_id, sort) [name: 'ix_ticket_tiers_event']
  }
}

Table ulaznice.event_access [headercolor: #7c3aed, note: 'Link online događaja; samo vlasnicima ulaznica (events-tickets), bez anon pristupa'] {
  event_id uuid [pk, ref: - ulaznice.events.id, note: 'on delete cascade']
  online_url text [note: 'https://, ≤ 1000']
  updated_at timestamptz [not null, default: `now()`]
}

// =====================================================================================
// Narudžba, ulaznice, audit
// =====================================================================================

Table ulaznice.orders [headercolor: #059669, note: 'Narudžba (bivši contributions na ticket kampanjama). id generira klijent (bearer capability). Pisanje: create_ticket_order, confirm_ticket_order_offchain, refund_ticket_order, expire_stale_ticket_orders'] {
  id uuid [pk, note: '= contributions.id; generira klijent']
  event_id uuid [not null, ref: > ulaznice.events.id, note: 'on delete cascade']
  tier_id uuid [not null, ref: > ulaznice.ticket_tiers.id, note: 'NO ACTION: tier s narudžbama se ne briše']
  buyer_account_id uuid [ref: > public.accounts.id, note: 'null = gost; on delete set null']
  amount_cents bigint [not null, note: '≥ 0; 0 samo na railu free']
  amount_received_cents bigint
  currency text [not null, default: 'eur']
  quantity integer [not null, default: 1, note: '> 0']
  state text [not null, default: 'pending', note: 'pending | paid | expired | refunded (trigger tg_order_state)']
  payment_rail text [not null, note: 'stripe | free | onchain (onchain samo kao istekla povijest, odluka 110)']
  external_payment_ref text [note: 'pi_… za stripe']
  buyer_email text
  holders jsonb [note: '[{full_name, email?}] za imenske tiere, ≤ 16 KB']
  reserved boolean [not null, default: false]
  reserve_expires_at timestamptz
  contributor_verified boolean [not null, default: false]
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (payment_rail, external_payment_ref) [unique, name: 'ux_orders_external_payment', note: 'idempotencija: jedan PaymentIntent = jedna narudžba']
    reserve_expires_at [name: 'ix_orders_reservation_expiry', note: "where state = 'pending' and reserved"]
    (event_id, state) [name: 'ix_orders_event']
    buyer_account_id [name: 'ix_orders_buyer']
    tier_id [name: 'ix_orders_tier']
    (buyer_account_id, created_at) [name: 'ix_orders_buyer_created', note: 'rate limit narudžbi po kupcu']
  }
}

Table ulaznice.tickets [headercolor: #059669, note: 'Ulaznica-komad. Holder polja su PII: anonimizirati nakon ends_at + 90 dana. Pisanje: deliver_ticket_orders, redeem_ticket, void_ticket, rotate_ticket_tokens'] {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, ref: > ulaznice.orders.id, note: 'on delete cascade']
  event_id uuid [not null, ref: > ulaznice.events.id, note: 'on delete cascade']
  tier_id uuid [ref: > ulaznice.ticket_tiers.id, note: 'on delete set null']
  serial text [not null, note: 'npr. MON-000042; unique po eventu']
  holder_name text [note: 'PII']
  holder_email text [note: 'PII']
  qr_token_hash text [not null, unique, note: 'sha256 hex opaque tokena']
  qr_token_once text [note: 'plaintext do prve dostave, zatim null']
  state ulaznice.ticket_state [not null, default: 'issued']
  checked_in_at timestamptz
  checked_in_by uuid [ref: > auth.users.id, note: 'skener; on delete set null']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (event_id, serial) [unique, name: 'tickets_event_serial_key']
    order_id [name: 'ix_tickets_order']
    (event_id, state) [name: 'ix_tickets_event']
  }
}

Table ulaznice.order_events [headercolor: #059669, note: 'Append-only audit narudžbe (bivši contribution_events); broji i rotacije QR-a'] {
  id bigint [pk, increment, note: 'identity; kopija zadržava stari id']
  order_id uuid [not null, ref: > ulaznice.orders.id, note: 'on delete cascade']
  event_id uuid [not null, ref: > ulaznice.events.id, note: 'on delete cascade']
  event_type text [not null, note: 'contribution.* | ticket.* | …']
  payload jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (order_id, created_at) [name: 'ix_order_events_order']
    (event_id, created_at) [name: 'ix_order_events_event']
    (order_id, event_type, created_at) [name: 'ix_order_events_rotate']
  }
}

// =====================================================================================
// Organizator
// =====================================================================================

Table ulaznice.organizer_allowlist [headercolor: #ea580c, note: 'Org accounti kojima je dopuštena objava eventa. Upis samo operater (service_role/psql); publish_event provjerava'] {
  account_id uuid [pk, ref: - public.accounts.id, note: 'on delete cascade']
  note text [note: '≤ 500']
  created_by uuid [ref: > auth.users.id, note: 'on delete set null']
  created_at timestamptz [not null, default: `now()`]
}

Table ulaznice.platform_admins [headercolor: #ea580c, note: 'Admini platforme: odobravaju događaje (approve_event, reject_event, review_queue). Upis samo operater (service_role/psql). Odobrenje admina zamjenjuje allowlist za taj događaj'] {
  user_id uuid [pk, ref: - auth.users.id, note: 'on delete cascade']
  note text [note: '≤ 500']
  created_at timestamptz [not null, default: `now()`]
}

Table ulaznice.organizer_records [headercolor: #ea580c, note: 'DAC7 evidencija organizatora. OSJETLJIVO: čitaju samo service_role i admin vlastitog org accounta. Pisanje: upsert_organizer_record'] {
  account_id uuid [pk, ref: - public.accounts.id, note: 'on delete cascade']
  legal_name text [not null]
  oib text [not null, note: '11 znamenki']
  address_line text [not null]
  city text [not null]
  postal_code text [not null]
  country_code text [not null, default: 'HR']
  contact_email text
  financial_identifier_type text [not null, default: 'safe_address', note: 'iban | safe_address']
  financial_identifier text [not null, note: 'IBAN ili 0x… adresa']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table ulaznice.organizer_payment_rails [headercolor: #ea580c, note: 'Stripe Connect stanje organizatora. Piše samo service_role (Worker nakon Stripe webhooka). event_rail_ready čita za objavu'] {
  account_id uuid [pk, ref: - public.accounts.id, note: 'on delete cascade']
  stripe_account_id text [unique, note: 'acct_…; nikad u javnim odgovorima']
  stripe_charges_enabled boolean [not null, default: false]
  stripe_payouts_enabled boolean [not null, default: false]
  invoice_provider text [not null, default: 'organizator', note: 'organizator | fira | domovina_fiskal']
  invoice_config jsonb [note: 'referenca na tajnu, nikad tajna; ≤ 8 KB']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// =====================================================================================
// Grupe
// =====================================================================================

TableGroup jezgra [color: #6b7280, note: 'Zajednički Supabase (SSO cijelog domovina.* ekosustava)'] {
  public.accounts
  auth.users
}

TableGroup dogadjaj [color: #7c3aed, note: 'Događaj, vrste ulaznica, link online događaja'] {
  ulaznice.events
  ulaznice.ticket_tiers
  ulaznice.event_access
}

TableGroup narudzba [color: #059669, note: 'Kupnja, izdane ulaznice, audit'] {
  ulaznice.orders
  ulaznice.tickets
  ulaznice.order_events
}

TableGroup organizator [color: #ea580c, note: 'Tko smije objaviti (allowlist ili odobrenje admina), DAC7, Stripe Connect'] {
  ulaznice.organizer_allowlist
  ulaznice.platform_admins
  ulaznice.organizer_records
  ulaznice.organizer_payment_rails
}

// =====================================================================================
// Bilješke
// =====================================================================================

Note rpc [color: #7c3aed] {
  '''
  RPC-i (SECURITY DEFINER, profil ulaznice)
  Narudžbe: create_ticket_order, confirm_ticket_order_offchain,
    deliver_ticket_orders, expire_stale_ticket_orders, list_my_tickets,
    redeem_ticket, void_ticket, refund_ticket_order, rotate_ticket_tokens
  Eventi: create_event, update_event, publish_event, delete_event_draft,
    event_rail_ready, organizer_overview, upsert_organizer_record
  Odobravanje: submit_event_for_review, review_queue, approve_event,
    reject_event, is_platform_admin
  '''
}

Note tok_kupnje [color: #059669] {
  '''
  Kupnja
  Worker /api/narudzba → events-order → create_ticket_order (pending, rezervacija)
  → Stripe PaymentIntent (events-stripe-intent) → webhook → events-stripe-confirm
  → confirm_ticket_order_offchain (paid) → deliver_ticket_orders (tickets + QR)
  Besplatno: rail free, odmah paid.  Istek: expire_stale_ticket_orders (cron).
  '''
}

Note tok_odobrenja [color: #ea580c] {
  '''
  Odobravanje događaja
  skica → submit_event_for_review (submitted_at) → review_queue (admin)
  → approve_event: active + public   |   reject_event: submitted_at = null, review_note
  Allowlistani organizator i dalje objavljuje sam (publish_event).
  Rail gate vrijedi i za admina.
  '''
}

Note tok_ulaza [color: #4b5563] {
  '''
  Ulaz na događaj
  skener (/skener) → events-checkin → redeem_ticket(qr) → hash = qr_token_hash
  → state issued → checked_in, checked_in_by = auth.users.id
  '''
}

